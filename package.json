{
  "name": "nkabom-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n emulators,worker,app -c magenta,yellow,cyan \"npm:emulators\" \"npm:worker\" \"npm:serve\"",
    "serve": "ng serve",
    "emulators": "firebase emulators:start --only auth,firestore --import=./.emulator-data --export-on-exit=./.emulator-data",
    "worker": "npm --prefix worker run dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && npm --prefix worker run lint",
    "format": "prettier --write . && npm --prefix worker run format",
    "format:check": "prettier --check . && npm --prefix worker run format:check",
    "postinstall": "npm --prefix worker install",
    "build:staging": "ng build --configuration production,staging",
    "deploy:staging": "npm run build:staging && firebase deploy --only hosting,firestore --project staging && npm --prefix worker run deploy:staging",
    "deploy:production": "npm run build && firebase deploy --only hosting,firestore --project production && npm --prefix worker run deploy:production",
    "test:worker": "npm --prefix worker test",
    "build:worker": "npm --prefix worker run typecheck && npm --prefix worker run build",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "icons": "node scripts/generate-icons.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.21.1",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "^21.2.25",
    "firebase": "^13.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "angular-eslint": "21.4.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.3.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12"
  }
}
