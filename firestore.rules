rules_version = '2';

// Default deny (FR-1.12): any path not matched below is closed. Only the Worker writes data,
// through the service account, which the rules do not apply to; the app reads. Shapes are in
// worker/src/model.ts. Admin access arrives with role claims in NKB-204.
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified email address (FR-1.2, NKB-202). Until then an account gets
    // nothing, so it cannot log in to any part of the site.
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    // users/{uid}: the account's role (FR-1.5). The Worker creates it on the account's first call.
    match /users/{uid} {
      allow get: if isSelf(uid);
    }

    // members/{uid}: the member's profile. The Worker writes it (worker/src/members.ts), which
    // checks every field and keeps the directory in step, so the app can only read its own.
    match /members/{uid} {
      allow get: if isSelf(uid);
    }

    // directory/{uid}: the limited profile of each active member (FR-3.1, FR-5.2), written by the
    // Worker in the same transaction as each change to members/{uid}. Only active members can
    // read it, and being active is what gives a member an entry of their own (FR-2.9). Members never
    // read the full record: members/{uid} stays readable only by its owner.
    match /directory/{uid} {
      allow read: if isVerified()
        && exists(/databases/$(database)/documents/directory/$(request.auth.uid));
    }

    // auditLog/{entryId}: admin actions (FR-8.3). Only the Worker adds entries, and no one
    // can edit or delete them from the app. Admins get read access for the viewer in NKB-406.
    match /auditLog/{entryId} {
      allow read, write: if false;
    }

    // emailVerifications/{uid}: when the account was last sent a verification email (NKB-202).
    // Only the Worker uses it, to limit resends.
    match /emailVerifications/{uid} {
      allow read, write: if false;
    }

    // jobStatus/{schedule}-{task}: the last run of each scheduled task (NKB-118), written by the
    // Worker. Closed to the app; an admin view could open reads later.
    match /jobStatus/{id} {
      allow read, write: if false;
    }
  }
}
