rules_version = '2';

// Default deny (FR-1.12): any path not matched below is closed. Shapes match
// functions/src/model.ts. Admin access arrives with role claims in NKB-208.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid}: the account's role (FR-1.5). Only Cloud Functions write it.
    match /users/{uid} {
      allow get: if isSelf(uid);
    }

    // members/{uid}: the member's profile. The document ID is the user ID, so a user can create
    // only their own profile and only once: a second write is an update, which is denied (FR-2.6).
    // The photo must be one uploaded to the member's own folder (worker/src/photos.ts).
    match /members/{uid} {
      allow get: if isSelf(uid);
      allow create: if isSelf(uid) && isNewProfile(request.resource.data);

      function isNewProfile(data) {
        let fields = ['firstNames', 'surname', 'dateOfBirth', 'stage', 'courseOrOccupation',
                      'graduationYear', 'photoPath', 'status', 'createdAt', 'updatedAt'];
        return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
          && isText(data.firstNames, 100)
          && isText(data.surname, 100)
          && data.dateOfBirth is string
          && data.dateOfBirth.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
          && data.stage in ['student', 'graduate']
          && isText(data.courseOrOccupation, 100)
          && data.graduationYear is int
          && data.graduationYear >= 1990
          && data.graduationYear <= request.time.year() + 8
          && data.photoPath is string
          && data.photoPath.matches('photos/' + uid + '/[0-9a-f-]{36}[.](jpg|png|webp)')
          && data.status == 'pending'
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      function isText(value, maxLength) {
        return value is string && value.trim().size() > 0 && value.size() <= maxLength;
      }
    }

    // directory/{uid}: the limited profile of each active member (FR-3.1, FR-5.2), copied from
    // members/{uid} by the syncDirectoryEntry function, its only writer. Only active members can
    // read it, and being active is what gives a member an entry of their own (FR-2.9). Members never
    // read the full record: members/{uid} stays readable only by its owner.
    match /directory/{uid} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/directory/$(request.auth.uid));
    }

    // auditLog/{entryId}: admin actions (FR-8.3). Only Cloud Functions add entries, and no one
    // can edit or delete them from the app. Admins get read access for the viewer in NKB-406.
    match /auditLog/{entryId} {
      allow read, write: if false;
    }
  }
}
