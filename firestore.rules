rules_version = '2';

// Default deny (FR-1.12): any path not matched below is closed. Only the Worker writes data,
// through the service account, which the rules do not apply to; the app reads. Shapes are in
// worker/src/model.ts. Admins read through role claims (NKB-204) and write nothing from the app.
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified email address (FR-1.2, NKB-202). Until then an account gets
    // nothing, so it cannot log in to any part of the site.
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    // An admin or Primary Admin (FR-1.5, FR-1.11). The role claim on the token (set by the Worker,
    // firebase-auth.ts) must agree with the account's users record, so an account demoted there
    // loses admin reads at once, without waiting for its token to expire. A deactivated admin's
    // record says so (NKB-209), which ends their reads at once too: the rules cannot ask Firebase
    // whether a sign-in was revoked, as the Worker does. A token with no claim is a member's. The
    // claim is checked first, so members cost no lookup; an admin's costs one read of their own
    // record, and an account with no record is denied.
    //
    // Admins log in with email and password only (FR-1.9, NKB-208), so an admin signed in another
    // way, such as with Google once members can (NKB-210), gets no admin reads.
    function isAdmin() {
      return isVerified()
        && request.auth.token.get('role', 'member') in ['admin', 'primaryAdmin']
        && request.auth.token.firebase.sign_in_provider == 'password'
        && activeAdminRecord(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        && adminSessionActive();
    }

    function activeAdminRecord(user) {
      return user.role in ['admin', 'primaryAdmin'] && user.get('status', 'active') == 'active';
    }

    // Admin sessions end after 30 minutes idle or 12 hours in all (FR-1.10, NKB-205), as in
    // worker/src/sessions.ts, which records each sign-in's last activity in sessions/{uid}. The
    // Worker writes it at most once a minute, so the idle limit here has a minute more. A sign-in
    // the Worker has not seen is refused, which the app avoids by calling GET /v1/me first.
    function adminSessionActive() {
      let signedIn = request.auth.token.auth_time;
      let signIns = get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.signIns;
      return request.time < timestamp.value(signedIn * 1000) + duration.value(12, 'h')
        && string(signedIn) in signIns
        && signIns[string(signedIn)] > request.time - duration.value(31, 'm');
    }

    // users/{uid}: the account's role (FR-1.5). The Worker creates it on the account's first call.
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow read: if isAdmin();
    }

    // members/{uid}: the member's profile. The Worker writes it (worker/src/members.ts), which
    // checks every field and keeps the directory in step, so the app can only read its own.
    match /members/{uid} {
      allow get: if isSelf(uid);
      allow read: if isAdmin(); // FR-3.1, FR-3.5
    }

    // directory/{uid}: the limited profile of each active member (FR-3.1, FR-5.2), written by the
    // Worker in the same transaction as each change to members/{uid}. Only active members can
    // read it, and being active is what gives a member an entry of their own (FR-2.9). Members never
    // read the full record: members/{uid} stays readable only by its owner.
    match /directory/{uid} {
      allow read: if isAdmin()
        || (isVerified()
          && exists(/databases/$(database)/documents/directory/$(request.auth.uid)));
    }

    // auditLog/{entryId}: admin actions (FR-8.3). Only the Worker adds entries, and no one
    // can edit or delete them from the app. Admins get read access for the viewer in NKB-406.
    match /auditLog/{entryId} {
      allow read, write: if false;
    }

    // emailVerifications/{uid}: when the account was last sent a verification email (NKB-202).
    // Only the Worker uses it, to limit resends.
    match /emailVerifications/{uid} {
      allow read, write: if false;
    }

    // sessions/{uid}: when each sign-in last called the Worker (NKB-205). Only the Worker and the
    // rules above use it.
    match /sessions/{uid} {
      allow read, write: if false;
    }

    // passwordResets/{uid}: the same for password reset emails (NKB-203).
    match /passwordResets/{uid} {
      allow read, write: if false;
    }

    // jobStatus/{schedule}-{task}: the last run of each scheduled task (NKB-118), written by the
    // Worker. Closed to the app; an admin view could open reads later.
    match /jobStatus/{id} {
      allow read, write: if false;
    }
  }
}
