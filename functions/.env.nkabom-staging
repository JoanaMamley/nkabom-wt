# Non-secret Functions settings for the staging project (nkabom-staging), read on deploy.
# Never put secrets here: set them with firebase functions:secrets:set (see the README).
R2_BUCKET=nkabom-photos-staging
EMAIL_PROVIDER=brevo
EMAIL_FROM_NAME=Nkabom
# EMAIL_FROM is added by the first deploy, which asks for it once the sending domain is verified.
# Set to true to make schedulerHeartbeat fail, to check retries and error logs (see the README).
HEARTBEAT_FAIL=false
BACKUP_BUCKET=gs://nkabom-staging-backups
