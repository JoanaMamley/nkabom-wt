# Non-secret Functions settings for the local emulators (project demo-nkabom), committed so the
# emulator does not prompt for them. Never put secrets here: they go in functions/.secret.local.
R2_BUCKET=nkabom-photos
R2_ENDPOINT=
# Emails are written to the Functions log instead of being sent.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@nkabom.test
EMAIL_FROM_NAME=Nkabom
# The emulator does not run scheduled functions, so no backups are made locally.
BACKUP_BUCKET=gs://demo-nkabom-backups
HEARTBEAT_FAIL=false
