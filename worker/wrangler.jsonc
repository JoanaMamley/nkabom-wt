// One Worker per environment, on the free plan at its workers.dev address (NKB-114).
// The top level is for local development (wrangler dev) against the Firebase emulators; staging and
// production do not inherit its vars or KV namespaces, so the emulator settings never reach them.
// Secrets are set per environment with wrangler secret put (see the README), never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nkabom-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "demo-nkabom",
    "ALLOWED_ORIGINS": "http://localhost:4200",
    "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8080",
    "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
    // Local only, so photo links work without secrets. Deployed Workers use the secret instead.
    "PHOTO_LINK_KEY": "local-photo-link-key",
    "APP_URL": "http://localhost:4200",
    // Emails, links included, are written to the wrangler dev log instead of being sent.
    "EMAIL_PROVIDER": "log",
  },
  // Local KV is simulated by wrangler dev, so these IDs are only labels.
  "kv_namespaces": [
    { "binding": "PHOTOS", "id": "local-photos" },
    { "binding": "BACKUPS", "id": "local-backups" },
  ],
  // Scheduled jobs (NKB-118): daily at 02:00 and every 5 minutes, UTC, which is also Ghana time.
  // They must match SCHEDULES in src/jobs.ts. Two per environment, within the free plan's 5 per
  // account; locally they run only when called (see the README).
  "triggers": { "crons": ["0 2 * * *", "*/5 * * * *"] },
  // Each environment has its own queue, made with npx wrangler queues create (see the README). One
  // message per invocation, so each task gets its own limits; jobs.ts retries failures itself.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "nkabom-jobs" }],
    "consumers": [{ "queue": "nkabom-jobs", "max_batch_size": 1, "max_retries": 3 }],
  },
  "env": {
    "staging": {
      "name": "nkabom-api-staging",
      "vars": {
        "FIREBASE_PROJECT_ID": "nkabom-staging",
        "ALLOWED_ORIGINS": "https://nkabom-staging.web.app,https://nkabom-staging.firebaseapp.com",
        "APP_URL": "https://nkabom-staging.web.app",
        "EMAIL_PROVIDER": "gmail",
      },
      // IDs from npx wrangler kv namespace create (see the README). They are not secret.
      "kv_namespaces": [
        { "binding": "PHOTOS", "id": "ed86557f77284290b2c5ccccc4140ef3" },
        { "binding": "BACKUPS", "id": "f33b56df355f4a3fb5c4c1aacd323c00" },
      ],
      "triggers": { "crons": ["0 2 * * *", "*/5 * * * *"] },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "nkabom-jobs-staging" }],
        "consumers": [{ "queue": "nkabom-jobs-staging", "max_batch_size": 1, "max_retries": 3 }],
      },
    },
    "production": {
      "name": "nkabom-api-prod",
      "vars": {
        "FIREBASE_PROJECT_ID": "nkabom-prod",
        "ALLOWED_ORIGINS": "https://nkabom-prod.web.app,https://nkabom-prod.firebaseapp.com",
        "APP_URL": "https://nkabom-prod.web.app",
        "EMAIL_PROVIDER": "gmail",
      },
      "kv_namespaces": [
        { "binding": "PHOTOS", "id": "a65fc0d43e434c8397c1c6c5a1eaebcf" },
        { "binding": "BACKUPS", "id": "2159c3a238934c0bb6080867656dcec8" },
      ],
      "triggers": { "crons": ["0 2 * * *", "*/5 * * * *"] },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "nkabom-jobs-prod" }],
        "consumers": [{ "queue": "nkabom-jobs-prod", "max_batch_size": 1, "max_retries": 3 }],
      },
    },
  },
}
